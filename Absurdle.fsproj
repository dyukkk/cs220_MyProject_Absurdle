<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Absurdle</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Absurdle/Feedback.fs" />
    <Compile Include="Absurdle/Adversary.fs" />
    <Compile Include="Absurdle/Render.fs" />
    <Compile Include="Absurdle/Words.fs" />
    <Compile Include="Absurdle/Game.fs" />
    <Compile Include="Absurdle/Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="words.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
